# Server Configuration
PROJECT_NAME="SmartServe AI Backend"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=True

# CORS Settings (JSON list or comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
# Default local development uses SQLite
# PostgreSQL deployment example: postgresql+psycopg2://user:password@localhost:5432/smartserve_db
DATABASE_URL="sqlite:///./smartserve.db"

# Weather API (OpenWeatherMap)
OPENWEATHERMAP_API_KEY="your_openopenweathermap_api_key_here"
RESTAURANT_CITY="Bengaluru"
RESTAURANT_LAT=12.9716
RESTAURANT_LON=77.5946

# Holiday API Configuration (Nager.Date default)
DEFAULT_COUNTRY_CODE="IN"
DEFAULT_REGION_CODE="KA"

# LLM Copilot Configuration
LLM_API_KEY="your_llm_api_key_here"
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"
